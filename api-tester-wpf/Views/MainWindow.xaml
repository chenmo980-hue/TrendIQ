<dmskin:DMSkinWindow
    x:Class="ApiTester.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dmskin="clr-namespace:DMSkin"
    xmlns:attached="clr-namespace:DMSkin.Attached"
    xmlns:vm="clr-namespace:ApiTester.Wpf.ViewModels"
    Title="API 测试工作台"
    Width="1180"
    Height="780"
    MinWidth="920"
    MinHeight="620"
    CaptionBackground="#0F172A"
    CaptionHeight="52"
    FitSystemWindow="False"
    Foreground="#E5E7EB"
    ResizeMode="CanResizeWithGrip"
    Style="{StaticResource DMSkinWindowStyle}"
    SystemButtonCloseOverColor="#EF4444"
    SystemButtonColor="#00FFFFFF"
    SystemButtonForeground="#CBD5E1"
    SystemButtonOverColor="#1E293B"
    SystemButtonSize="52"
    WindowStartupLocation="CenterScreen">
    <dmskin:DMSkinWindow.DataContext>
        <vm:MainViewModel />
    </dmskin:DMSkinWindow.DataContext>

    <dmskin:DMSkinWindow.TitleContent>
        <Grid Background="#111827">
            <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Path Width="18" Height="18" Data="{StaticResource DMSkin}" Fill="#38BDF8" Stretch="Fill" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC" Text="API 测试工作台" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#64748B" Text="OpenAI 兼容接口" />
            </StackPanel>
        </Grid>
    </dmskin:DMSkinWindow.TitleContent>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" Text="连接设置" />
                    <TextBlock Margin="0,4,0,0" Foreground="#94A3B8" Text="配置服务地址与密钥，密钥仅保存在当前运行内存中。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="#22C55E" Margin="0,0,8,0" />
                    <TextBlock Foreground="#86EFAC" Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,0" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,18,14">
                    <TextBlock Foreground="#94A3B8" Text="API 基本网址" />
                    <TextBox Margin="0,6,0,0" Height="34" Padding="10,0,0,0" VerticalContentAlignment="Center"
                             Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,18,14">
                    <TextBlock Foreground="#94A3B8" Text="API 密钥" />
                    <Grid Margin="0,6,0,0" Height="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                     Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"
                                     PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged" />
                        <TextBox x:Name="ApiKeyTextBox" Padding="10,0,0,0" VerticalContentAlignment="Center"
                                 Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0"
                                 Visibility="Collapsed" TextChanged="ApiKeyTextBox_OnTextChanged" />
                        <Button Grid.Column="1" Width="58" Margin="6,0,0,0" Content="显示" Foreground="#BAE6FD"
                                Background="#1E293B" BorderBrush="#334155" Click="RevealKeyButton_OnClick" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,14">
                    <Button Height="34" MinWidth="108" Padding="16,0,16,0" Content="拉取模型" Foreground="#082F49"
                            Background="#38BDF8" BorderBrush="#38BDF8" FontWeight="SemiBold"
                            Command="{Binding FetchModelsCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,18,14">
                    <TextBlock Foreground="#94A3B8" Text="模型（可选择或手动输入）" />
                    <ComboBox Margin="0,6,0,0" Height="34" Padding="8,0,0,0"
                               ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, UpdateSourceTrigger=PropertyChanged}"
                               Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0" />
                </StackPanel>
                <Border Grid.Row="1" Grid.Column="2" Margin="0,0,0,14" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Foreground="#94A3B8" Text="已发现模型" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,4,0,0" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Text="{Binding Models.Count, StringFormat={}{0}}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
                    <ScrollViewer Style="{StaticResource DMScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="150">
                        <ItemsControl ItemsSource="{Binding Models}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="9,6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="5">
                                        <TextBlock Foreground="#CBD5E1" Text="{Binding}" FontFamily="Consolas" FontSize="12" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Text="消息内容" />
                    <TextBox Margin="0,10,0,0" MinHeight="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0" Padding="10" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock Foreground="#94A3B8" Text="最大输出 token" VerticalAlignment="Center" />
                        <TextBox Width="88" Margin="10,0,0,0" Padding="7,0,0,0" VerticalContentAlignment="Center"
                                 Text="{Binding MaxTokensText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0F172A" BorderBrush="#334155" Foreground="#E2E8F0" />
                        <Button Margin="14,0,0,0" MinWidth="108" Height="34" Content="发送消息" Foreground="#052E16"
                                Background="#4ADE80" BorderBrush="#4ADE80" FontWeight="SemiBold"
                                Command="{Binding SendMessageCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                        <Button Margin="10,0,0,0" Height="34" Padding="14,0,14,0" Content="清空结果" Foreground="#CBD5E1"
                                Background="#1E293B" BorderBrush="#334155" Command="{Binding ClearOutputCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Margin="12,0,0,10" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="#F8FAFC" FontSize="16" FontWeight="SemiBold" Text="响应结果" />
                        <TextBlock Margin="12,0,0,0" Foreground="#64748B" Text="JSON / 错误诊断" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox Margin="0,10,0,0" MinHeight="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="{Binding OutputText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0F172A" BorderBrush="#1E293B" Foreground="#D1FAE5" Padding="10"
                             FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,0,0,0">
            <TextBlock Foreground="#64748B" Text="支持 /models 与 /chat/completions · 使用 DMSkin 自定义窗口与深色界面" />
        </Border>
    </Grid>
</dmskin:DMSkinWindow>
