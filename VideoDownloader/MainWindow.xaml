<Window x:Class="TrendIQDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TrendIQ Downloader" Height="760" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1F24">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3F4B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2B2D33"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#3A3F4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2B2D33"/>
            <Setter Property="Foreground" Value="#E8E8E8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：链接输入 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="UrlBox_KeyDown" FontSize="14" Padding="8,7"
                     Tag="粘贴视频或播放列表链接 (支持 YouTube/B站/抖音等数千站点)"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
            <Button Content="解析" Background="#4F8CFF" Click="OnParse" IsEnabled="{Binding NotBusy}"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="2" Margin="8,0,0,0">
            <Button Content="工具/更新" Click="OnTools" IsEnabled="{Binding NotBusy}"/>
        </Grid>

        <!-- 视频信息卡 -->
        <Border Grid.Row="1" Margin="0,12" Padding="12" Background="#26272C" CornerRadius="6"
                Visibility="{Binding InfoVisibility}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" x:Name="ThumbImage" Width="160" Height="90" Stretch="UniformToFill"
                           Source="{Binding ThumbnailImage}" Cursor="Hand" MouseLeftButtonDown="OnThumbClick"/>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title}" Text="{Binding Title}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Uploader}"/>
                            <TextBlock Style="{StaticResource Label}" Text="  ·  " />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding DurationText}"/>
                            <TextBlock Style="{StaticResource Label}" Text="  ·  " />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Site}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Label}" Text="格式：" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" x:Name="FormatCombo" ItemsSource="{Binding Formats}"
                              SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Display"
                              HorizontalAlignment="Stretch" Margin="0,0,12,0"/>
                    <CheckBox Grid.Column="2" Content="仅音频" IsChecked="{Binding AudioOnly}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox Grid.Column="3" Width="80" ItemsSource="{Binding AudioFormats}"
                              SelectedItem="{Binding SelectedAudioFormat}"
                              IsEnabled="{Binding AudioOnly}"/>
                    <CheckBox Grid.Column="4" Content="字幕" IsChecked="{Binding DownloadSubs}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox Grid.Column="5" Width="110" x:Name="SubLangCombo" Text="zh,en"
                              IsEditable="True" IsEnabled="{Binding DownloadSubs}"/>
                    <CheckBox Grid.Column="6" Content="封面" IsChecked="{Binding DownloadThumb}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                    <Button Grid.Column="7" Content="开始下载" Background="#3DD68C" FontWeight="SemiBold"
                            Click="OnDownload" IsEnabled="{Binding NotBusy}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 中部：任务列表 + 日志 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#26272C" CornerRadius="6" Padding="4">
                <DataGrid x:Name="TaskGrid" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False"
                          Background="Transparent" BorderThickness="0" RowBackground="#2C2E34"
                          AlternatingRowBackground="#26272C" Foreground="#E0E0E0"
                          HeadersVisibility="Column" GridLinesVisibility="None" CanUserAddRows="False"
                          SelectionMode="Single" IsReadOnly="True" FontSize="12.5"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="3*" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="6,0"/>
                                    <Setter Property="TextAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="进度" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4,12,4">
                                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="12"
                                                     Background="#1A1B1F" Foreground="#4F8CFF" BorderThickness="0"/>
                                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" FontSize="11" Foreground="#DADADA"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="操作" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3">
                                        <Button Content="取消" FontSize="11.5" Padding="10,4" Margin="0,0,6,0" Background="#8A3B3B"
                                                Click="OnCancelTask" Tag="{Binding}" IsEnabled="{Binding CanCancel}"/>
                                        <Button Content="打开" FontSize="11.5" Padding="10,4" Background="#3A3F4B"
                                                Click="OnOpenFile" Tag="{Binding}" IsEnabled="{Binding CanOpen}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <GridSplitter Grid.Row="1" Background="Transparent" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
            <Border Grid.Row="2" Background="#222327" CornerRadius="6" Padding="8">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Text="{Binding LogText}" FontFamily="Consolas" FontSize="12"
                               Foreground="#9FB0A8" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底栏：状态 + 设置 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Label}" Text="{Binding StatusText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="{Binding YtDlpVersion}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock Grid.Column="2"/>
            <Button Grid.Column="3" Content="下载目录" Click="OnBrowseOutput" FontSize="12"/>
            <Button Grid.Column="4" Content="设置" Click="OnSettings" Margin="8,0,0,0" FontSize="12"/>
            <Button Grid.Column="5" Content="暂停全部" Margin="8,0,0,0" FontSize="12" Click="OnPauseAll"
                    Visibility="{Binding PauseAllVisibility}"/>
        </Grid>
    </Grid>
</Window>
